// The module the app and the packet tunnel import as `Hako`. Same four headers,
// same order, as the module map gomobile writes into Hako.xcframework; the
// headers themselves are copied out of the locked xcframework at build time
// (see the HakoCore target in project.yml), so this file never carries a copy
// that could drift from HakoSDK.lock.json.
framework module Hako {
    header "ref.h"
    header "Hako.objc.h"
    header "Universe.objc.h"
    header "Hako.h"
    export *
}
